{
  "name": "seth-and-sons-dryfruits",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,SHOP,ADMIN -c green,yellow,cyan \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:admin\"",
    "dev:server": "tsx watch --ignore tests --ignore src --ignore dist server/index.ts",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "dev:admin": "vite --port=8000 --host=0.0.0.0",
    "build": "vite build",
    "start": "tsx server/index.ts --prod",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit --singleThreaded",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@embedpdf/viewer-react": "^3.1.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.4",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "gsap": "^3.15.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.12.1",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.7",
    "mongodb-memory-server": "^11.3.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
